{
  "name": "lagtag",
  "version": "1.0.0",
  "description": "4-player browser tag game showcasing real-time netcode: client-side prediction, reconciliation, interpolation, lag compensation over WebRTC + Socket.IO",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.33.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  },
  "license": "MIT"
}
